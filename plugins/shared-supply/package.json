{
  "name": "@nexus/plugin-shared-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus shared supply plugin: catalogue browsing, image search and local favourites",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./manifest": {
      "types": "./dist/nexus.plugin.d.ts",
      "import": "./dist/nexus.plugin.js"
    }
  },
  "files": [
    "dist",
    "nexus.plugin.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*",
    "zod": "4.4.3"
  }
}
