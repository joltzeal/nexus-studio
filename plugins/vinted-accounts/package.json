{
  "name": "@nexus/plugin-vinted-accounts",
  "version": "1.4.1",
  "private": true,
  "description": "Raccoon Vinted account pool plugin: credential records, CSV/XLSX import, window bindings, order-watch and Bark notifications",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./manifest": {
      "types": "./dist/nexus.plugin.d.ts",
      "import": "./dist/nexus.plugin.js"
    },
    "./agent-contracts": {
      "types": "./src/agent-contracts.ts",
      "import": "./dist/src/agent-contracts.js"
    }
  },
  "files": [
    "dist",
    "nexus.plugin.ts",
    "src/agent-contracts.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@nexus/plugin-sdk": "workspace:*",
    "htmlparser2": "10.0.0",
    "tough-cookie": "6.0.2",
    "zod": "4.4.3"
  }
}
